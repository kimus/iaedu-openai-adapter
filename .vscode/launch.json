{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iaedu-openai-adapter: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "iaedu_openai_adapter.proxy:app",
        "--host",
        "0.0.0.0",
        "--port",
        "3067",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": true,
      "justMyCode": true
    }
  ]
}
